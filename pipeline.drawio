<mxfile host="app.diagrams.net"><diagram name="Pipeline nghiên cứu" id="pipeline-kltn"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" vertex="1" value="PIPELINE KHÓA LUẬN: HỌC TĂNG CƯỜNG ĐA TÁC TỬ CHO ĐẶT HÀNG LẠI ĐA KHO" style="text;html=1;whiteSpace=wrap;fontSize=fontSize=26;fontStyle=1;align=center;fontColor=#16365C;;"><mxGeometry x="0" y="20" width="1840" height="44" as="geometry"/></mxCell><mxCell id="sub" parent="1" vertex="1" value="Dữ liệu M5 Walmart · 10 kho × 30 SKU = 300 cặp · 300 tác tử dùng chung MỘT mạng chính sách π&lt;sub&gt;θ&lt;/sub&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;fontColor=#5C6378;"><mxGeometry x="0" y="66" width="1840" height="26" as="geometry"/></mxCell><mxCell id="s1" parent="1" vertex="1" value="&lt;b&gt;1 · DỮ LIỆU M5&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bán hàng theo ngày&lt;br&gt;Lịch &amp;amp; sự kiện&lt;br&gt;Giá bán theo tuần" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="60" y="130" width="250" height="160" as="geometry"/></mxCell><mxCell id="s2" parent="1" vertex="1" value="&lt;b&gt;2 · TIỀN XỬ LÝ &amp;amp; CHIA MIỀN&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chọn 30 SKU, 10 kho&lt;br&gt;train 29/01/2011–13/12/2013&lt;br&gt;val 14/12/2013–17/01/2015&lt;br&gt;test 18/01/2015–22/05/2016" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="390" y="130" width="290" height="160" as="geometry"/></mxCell><mxCell id="s3" parent="1" vertex="1" value="&lt;b&gt;3 · MÔI TRƯỜNG MÔ PHỎNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quan sát 44 chiều · 6 mức đặt&lt;br&gt;Lead time 1–3 ngày, sức chứa kho&lt;br&gt;Thưởng = −(chi phí + phạt SLA)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="760" y="130" width="290" height="160" as="geometry"/></mxCell><mxCell id="s4" parent="1" vertex="1" value="&lt;b&gt;4 · HUẤN LUYỆN PS-IPPO&lt;/b&gt;&lt;br&gt;&lt;br&gt;300 tác tử · một Actor–Critic chung&lt;br&gt;10.000 episode × 3 seed&lt;br&gt;(offline, GPU)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E4D5F2;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;strokeWidth=3;"><mxGeometry x="1130" y="130" width="300" height="160" as="geometry"/></mxCell><mxCell id="base" parent="1" vertex="1" value="&lt;b&gt;5 · BASELINE CỔ ĐIỂN&lt;/b&gt;&lt;br&gt;&lt;br&gt;EOQ · (s,S) · Newsvendor&lt;br&gt;cả bản chung và bản theo nhóm cầu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCE4D6;strokeColor=#C55A11;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="760" y="380" width="290" height="150" as="geometry"/></mxCell><mxCell id="ckpt" parent="1" vertex="1" value="&lt;b&gt;Checkpoint&lt;/b&gt;&lt;br&gt;best_model.pth&lt;br&gt;(chọn theo miền val)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;fontSize=14;fontColor=#1F2937;"><mxGeometry x="1160" y="370" width="240" height="170" as="geometry"/></mxCell><mxCell id="demo" parent="1" vertex="1" value="&lt;b&gt;9 · ỨNG DỤNG MÔ PHỎNG&lt;/b&gt;&lt;br&gt;&lt;i&gt;(chỉ suy luận, không train)&lt;/i&gt;&lt;br&gt;&lt;br&gt;Kết quả · Đơn đặt hàng · Chi tiết&lt;br&gt;So sánh · Kịch bản tăng cầu&lt;br&gt;Phiếu đề nghị: nháp → duyệt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="1530" y="350" width="290" height="210" as="geometry"/></mxCell><mxCell id="eval" parent="1" vertex="1" value="&lt;b&gt;6 · ĐÁNH GIÁ CHUNG (miền test)&lt;/b&gt;&lt;br&gt;&lt;br&gt;30 lần mỗi chính sách, cùng hạt giống&lt;br&gt;Chi phí · Fill rate · Thiếu hàng&lt;br&gt;Tồn kho · Tràn kho" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DDEBF7;strokeColor=#4472C4;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="1000" y="650" width="330" height="170" as="geometry"/></mxCell><mxCell id="ana" parent="1" vertex="1" value="&lt;b&gt;7 · PHÂN TÍCH&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cùng mức phục vụ · nhiều seed&lt;br&gt;Kiểm định thống kê · ablation&lt;br&gt;Giai đoạn nhu cầu · sốc cầu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="580" y="650" width="330" height="170" as="geometry"/></mxCell><mxCell id="out" parent="1" vertex="1" value="&lt;b&gt;8 · ĐẦU RA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bảng &amp;amp; hình kết quả&lt;br&gt;Báo cáo LaTeX&lt;br&gt;Poster" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="160" y="650" width="330" height="170" as="geometry"/></mxCell><mxCell id="e1" parent="1" edge="1" source="s1" target="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" parent="1" edge="1" source="s2" target="s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" parent="1" edge="1" source="s3" target="s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" parent="1" edge="1" source="s3" target="base" value="chạy cùng môi trường" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" parent="1" edge="1" source="s4" target="ckpt" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#9673A6;fontSize=12;fontStyle=1;fontColor=#9673A6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" parent="1" edge="1" source="ckpt" target="demo" value="nạp checkpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#0F9A4C;fontSize=12;fontStyle=1;fontColor=#0F9A4C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" parent="1" edge="1" source="base" target="eval" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.25;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" parent="1" edge="1" source="ckpt" target="eval" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#9673A6;fontSize=12;fontStyle=1;fontColor=#9673A6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" parent="1" edge="1" source="eval" target="ana" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" parent="1" edge="1" source="ana" target="out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note1" parent="1" vertex="1" value="&lt;b&gt;Ba miền không chồng lấn:&lt;/b&gt; train để học · val để chọn mô hình và tinh chỉnh baseline · test chỉ dùng một lần để báo cáo." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#374151;"><mxGeometry x="60" y="860" width="1760" height="28" as="geometry"/></mxCell><mxCell id="note2" parent="1" vertex="1" value="&lt;b&gt;Phạm vi:&lt;/b&gt; đầu ra của mô hình là yêu cầu đặt hàng lại (số lượng, thời điểm, kho–mặt hàng). Hỏi báo giá và chọn nhà cung cấp nằm ngoài phạm vi vì M5 không có dữ liệu nhà cung cấp." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#374151;"><mxGeometry x="60" y="890" width="1760" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="02 · Mô hình MDP" id="p2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" parent="1" vertex="1" value="MÔ HÌNH HÓA ĐẶT HÀNG LẠI THÀNH BÀI TOÁN MDP ĐA TÁC TỬ" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=center;fontColor=#16365C;"><mxGeometry x="0" y="20" width="1500" height="44" as="geometry"/></mxCell><mxCell id="st" parent="1" vertex="1" value="Mỗi cặp (kho, SKU) là một tác tử; 300 tác tử dùng chung một chính sách π&lt;sub&gt;θ&lt;/sub&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;fontColor=#5C6378;"><mxGeometry x="0" y="64" width="1500" height="26" as="geometry"/></mxCell><mxCell id="ag" parent="1" vertex="1" value="&lt;b&gt;TÁC TỬ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cặp (kho i, SKU j)&lt;br&gt;300 tác tử&lt;br&gt;chính sách π&lt;sub&gt;θ&lt;/sub&gt;(a | o) dùng chung" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E4D5F2;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;strokeWidth=3;"><mxGeometry x="80" y="200" width="300" height="220" as="geometry"/></mxCell><mxCell id="ac" parent="1" vertex="1" value="&lt;b&gt;HÀNH ĐỘNG a&lt;/b&gt;&lt;br&gt;&lt;br&gt;6 mức đặt hàng rời rạc&lt;br&gt;→ quy ra số lượng đặt Q" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="500" y="200" width="260" height="220" as="geometry"/></mxCell><mxCell id="en" parent="1" vertex="1" value="&lt;b&gt;MÔI TRƯỜNG (một ngày)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Nhận hàng, lead time 1–3 ngày&lt;br&gt;2. Ràng buộc sức chứa từng kho&lt;br&gt;3. Bán hàng, cập nhật fill rate 30 ngày&lt;br&gt;4. Tính chi phí" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="880" y="200" width="300" height="220" as="geometry"/></mxCell><mxCell id="rw" parent="1" vertex="1" value="&lt;b&gt;PHẦN THƯỞNG r&lt;/b&gt;&lt;br&gt;&lt;br&gt;−( lưu kho + thiếu hàng + đặt hàng&lt;br&gt;+ tràn kho + phạt mức phục vụ )&lt;br&gt;chuẩn hóa theo từng cặp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="880" y="540" width="300" height="230" as="geometry"/></mxCell><mxCell id="ob" parent="1" vertex="1" value="&lt;b&gt;QUAN SÁT o (44 chiều)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trạng thái của cặp&lt;br&gt;Lịch sử nhu cầu 7 ngày&lt;br&gt;Tín hiệu kho, giá, lịch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="80" y="540" width="300" height="230" as="geometry"/></mxCell><mxCell id="mt" parent="1" vertex="1" value="&lt;b&gt;MỤC TIÊU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Giảm tổng chi phí vận hành&lt;br&gt;với fill rate ≥ 85%" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#16365C;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="500" y="540" width="260" height="230" as="geometry"/></mxCell><mxCell id="a1" parent="1" edge="1" source="ob" target="ag" value="o" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" parent="1" edge="1" source="ag" target="ac" value="chọn mức đặt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" parent="1" edge="1" source="ac" target="en" value="Q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" parent="1" edge="1" source="en" target="rw" value="chi phí &amp;amp; mức phục vụ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a5" parent="1" edge="1" source="rw" target="ob" value="r (dùng để học)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#B85450;fontSize=12;fontStyle=1;fontColor=#B85450;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="03 · Quan sát 44 chiều" id="p3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" parent="1" vertex="1" value="VÉC-TƠ QUAN SÁT 44 CHIỀU CỦA MỘT TÁC TỬ" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=center;fontColor=#16365C;"><mxGeometry x="0" y="20" width="1600" height="44" as="geometry"/></mxCell><mxCell id="st" parent="1" vertex="1" value="Chia theo ba nhóm: trạng thái của cặp, lịch sử nhu cầu, tín hiệu ngoại sinh" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;fontColor=#5C6378;"><mxGeometry x="0" y="64" width="1600" height="26" as="geometry"/></mxCell><mxCell id="g1" parent="1" vertex="1" value="&lt;b&gt;1 · TRẠNG THÁI CỦA CẶP (10 chiều)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tồn kho (1)&lt;br&gt;Vị thế tồn kho = tồn + hàng đang về (1)&lt;br&gt;Hàng đang về theo ngày (3)&lt;br&gt;Fill rate cửa sổ 30 ngày (1)&lt;br&gt;Quy mô cầu của cặp (1)&lt;br&gt;Mức đầy kho util (1)&lt;br&gt;Tỷ trọng tồn của cặp trong kho share (1)&lt;br&gt;Mức giảm giá g (1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="60" y="130" width="470" height="520" as="geometry"/></mxCell><mxCell id="g2" parent="1" vertex="1" value="&lt;b&gt;2 · LỊCH SỬ NHU CẦU (7 chiều)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhu cầu 7 ngày gần nhất&lt;br&gt;(log1p, chuẩn hóa theo cầu trung bình)&lt;br&gt;&lt;br&gt;&lt;i&gt;Giúp tác tử thấy xu hướng bán&lt;br&gt;mà không cần dự báo riêng&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="560" y="130" width="470" height="520" as="geometry"/></mxCell><mxCell id="g3" parent="1" vertex="1" value="&lt;b&gt;3 · TÍN HIỆU NGOẠI SINH (27 chiều)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày trong tuần (7)&lt;br&gt;Cờ lịch M5 (20): SNAP, sự kiện,&lt;br&gt;ngày lễ, tháng&lt;br&gt;&lt;br&gt;Mức giảm giá g ∈ [0, 1] là biến liên tục:&lt;br&gt;đo so với giá trung bình của chính cặp,&lt;br&gt;ước lượng chỉ trên miền train" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="1060" y="130" width="470" height="520" as="geometry"/></mxCell><mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;Mô hình biết tín hiệu mạnh hay yếu bằng cách nào?&lt;/b&gt; Cờ lịch chỉ là 0/1; mức tác động do mạng tự học qua trọng số. Giảm giá là số liên tục nên độ sâu giảm giá được đưa thẳng vào mạng. Mỗi cặp 44 chiều, 300 cặp → ma trận quan sát 300 × 44 mỗi ngày." style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#374151;"><mxGeometry x="60" y="680" width="1470" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="04 · Kiến trúc PS-IPPO" id="p4"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" parent="1" vertex="1" value="PS-IPPO: 300 TÁC TỬ, MỘT BỘ THAM SỐ DÙNG CHUNG" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=center;fontColor=#16365C;"><mxGeometry x="0" y="20" width="1700" height="44" as="geometry"/></mxCell><mxCell id="st" parent="1" vertex="1" value="Một lần forward cho cả 300 cặp; chỉ MỘT mạng được huấn luyện, không phải 300 mô hình" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;fontColor=#5C6378;"><mxGeometry x="0" y="64" width="1700" height="26" as="geometry"/></mxCell><mxCell id="o" parent="1" vertex="1" value="&lt;b&gt;Ma trận quan sát&lt;/b&gt;&lt;br&gt;300 × 44&lt;br&gt;mỗi ngày" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#B7E1E4;strokeColor=#3F8E95;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="60" y="180" width="260" height="160" as="geometry"/></mxCell><mxCell id="ac" parent="1" vertex="1" value="&lt;b&gt;Actor&lt;/b&gt; 44 → 128 → 128 → 6&lt;br&gt;tốc độ học 3·10⁻⁴" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCE9F7;strokeColor=#7EA6D9;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="430" y="150" width="340" height="100" as="geometry"/></mxCell><mxCell id="cr" parent="1" vertex="1" value="&lt;b&gt;Critic&lt;/b&gt; 44 → 128 → 128 → 1&lt;br&gt;tốc độ học 1·10⁻³" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCE9F7;strokeColor=#7EA6D9;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="430" y="280" width="340" height="100" as="geometry"/></mxCell><mxCell id="ao" parent="1" vertex="1" value="&lt;b&gt;Hành động&lt;/b&gt; (300)&lt;br&gt;mỗi cặp chọn 1 trong 6 mức" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="880" y="150" width="300" height="100" as="geometry"/></mxCell><mxCell id="vo" parent="1" vertex="1" value="&lt;b&gt;Giá trị V(o)&lt;/b&gt; (300)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#CCE5F6;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="880" y="280" width="300" height="100" as="geometry"/></mxCell><mxCell id="en" parent="1" vertex="1" value="&lt;b&gt;Môi trường&lt;/b&gt;&lt;br&gt;chạy một ngày&lt;br&gt;→ thưởng r, quan sát mới" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="1290" y="150" width="330" height="230" as="geometry"/></mxCell><mxCell id="b1" parent="1" vertex="1" value="&lt;b&gt;RolloutBuffer&lt;/b&gt;&lt;br&gt;1024 bước × 300 cặp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDE9D9;strokeColor=#E8A33D;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="60" y="520" width="300" height="130" as="geometry"/></mxCell><mxCell id="b2" parent="1" vertex="1" value="&lt;b&gt;GAE độc lập theo từng cặp&lt;/b&gt;&lt;br&gt;γ = 0,99 · λ = 0,95" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDE9D9;strokeColor=#E8A33D;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="430" y="520" width="300" height="130" as="geometry"/></mxCell><mxCell id="b3" parent="1" vertex="1" value="&lt;b&gt;Làm phẳng 307.200 mẫu&lt;/b&gt;&lt;br&gt;mini-batch 16.384" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCE9F7;strokeColor=#7EA6D9;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="800" y="520" width="300" height="130" as="geometry"/></mxCell><mxCell id="b4" parent="1" vertex="1" value="&lt;b&gt;Cập nhật PPO&lt;/b&gt;&lt;br&gt;clip ε = 0,2 · 4 epoch · dừng sớm theo target_kl" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E4D5F2;strokeColor=#9673A6;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="1170" y="520" width="450" height="130" as="geometry"/></mxCell><mxCell id="k1" parent="1" edge="1" source="o" target="ac" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k2" parent="1" edge="1" source="o" target="cr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k3" parent="1" edge="1" source="ac" target="ao" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k4" parent="1" edge="1" source="cr" target="vo" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k5" parent="1" edge="1" source="ao" target="en" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k6" parent="1" edge="1" source="en" target="b4" value="mẫu (o, a, r, V) mỗi ngày" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k7" parent="1" edge="1" source="b4" target="b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k8" parent="1" edge="1" source="b3" target="b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k9" parent="1" edge="1" source="b2" target="b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n" parent="1" vertex="1" value="&lt;b&gt;Vòng học:&lt;/b&gt; thu mẫu vào RolloutBuffer → tính lợi thế GAE theo từng cặp → làm phẳng thành mini-batch → cập nhật PPO cho Actor và Critic chung. 10.000 episode × 365 ngày, 3 seed (42, 1, 2). Mô hình tốt nhất chọn theo chi phí miền val trong các lần đánh giá đạt fill ≥ 85%." style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#374151;"><mxGeometry x="60" y="690" width="1560" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="05 · Chia dữ liệu theo thời gian" id="p5"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" parent="1" vertex="1" value="CHIA DỮ LIỆU THEO THỜI GIAN: TRAIN / VAL / TEST" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=center;fontColor=#16365C;"><mxGeometry x="0" y="20" width="1700" height="44" as="geometry"/></mxCell><mxCell id="st" parent="1" vertex="1" value="Ba miền không chồng lấn; mỗi episode 365 ngày nằm gọn trong một miền" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;fontColor=#5C6378;"><mxGeometry x="0" y="64" width="1700" height="26" as="geometry"/></mxCell><mxCell id="tr" parent="1" vertex="1" value="&lt;b&gt;TRAIN · 1.050 ngày&lt;/b&gt;&lt;br&gt;29/01/2011 – 13/12/2013&lt;br&gt;học chính sách; ước lượng cầu và giá trung bình" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#B7E1E4;strokeColor=#3F8E95;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="60" y="160" width="630" height="130" as="geometry"/></mxCell><mxCell id="va" parent="1" vertex="1" value="&lt;b&gt;VAL · 400 ngày&lt;/b&gt;&lt;br&gt;14/12/2013 – 17/01/2015&lt;br&gt;chọn mô hình, tinh chỉnh baseline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#C6E0B4;strokeColor=#82B366;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="690" y="160" width="380" height="130" as="geometry"/></mxCell><mxCell id="te" parent="1" vertex="1" value="&lt;b&gt;TEST · 491 ngày&lt;/b&gt;&lt;br&gt;18/01/2015 – 22/05/2016&lt;br&gt;chỉ dùng một lần để báo cáo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFE699;strokeColor=#C00000;strokeWidth=2;fontSize=15;fontColor=#1F2937;align=center;verticalAlign=middle;strokeWidth=3;"><mxGeometry x="1070" y="160" width="570" height="130" as="geometry"/></mxCell><mxCell id="a0" parent="1" vertex="1" value="ngày 0" style="text;html=1;whiteSpace=wrap;fontSize=12;"><mxGeometry x="60" y="300" width="200" height="24" as="geometry"/></mxCell><mxCell id="a1" parent="1" vertex="1" value="ngày 1.050" style="text;html=1;whiteSpace=wrap;fontSize=12;"><mxGeometry x="640" y="300" width="200" height="24" as="geometry"/></mxCell><mxCell id="a2" parent="1" vertex="1" value="ngày 1.450" style="text;html=1;whiteSpace=wrap;fontSize=12;"><mxGeometry x="1020" y="300" width="200" height="24" as="geometry"/></mxCell><mxCell id="a3" parent="1" vertex="1" value="ngày 1.941" style="text;html=1;whiteSpace=wrap;fontSize=12;"><mxGeometry x="1540" y="300" width="200" height="24" as="geometry"/></mxCell><mxCell id="w1" parent="1" vertex="1" value="&lt;b&gt;Cửa sổ nhu cầu&lt;/b&gt;&lt;br&gt;7 ngày gần nhất" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="60" y="400" width="300" height="120" as="geometry"/></mxCell><mxCell id="w2" parent="1" vertex="1" value="&lt;b&gt;Cửa sổ fill rate&lt;/b&gt;&lt;br&gt;30 ngày trượt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="420" y="400" width="300" height="120" as="geometry"/></mxCell><mxCell id="w3" parent="1" vertex="1" value="&lt;b&gt;Một episode&lt;/b&gt;&lt;br&gt;365 ngày" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="780" y="400" width="300" height="120" as="geometry"/></mxCell><mxCell id="w4" parent="1" vertex="1" value="&lt;b&gt;Giá&lt;/b&gt;: giá trung bình chỉ tính trên miền train&lt;br&gt;giá theo ngày dùng làm tín hiệu giảm giá" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="1140" y="400" width="500" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="06 · Kết quả chính" id="p6"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" parent="1" vertex="1" value="KẾT QUẢ CHÍNH TRÊN MIỀN TEST (3 SEED, 30 LẦN ĐÁNH GIÁ)" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=center;fontColor=#16365C;"><mxGeometry x="0" y="20" width="1700" height="44" as="geometry"/></mxCell><mxCell id="st" parent="1" vertex="1" value="Số lấy từ results/KET_QUA.txt; Δ% = (IPPO − baseline) / baseline, âm = IPPO rẻ hơn" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;fontColor=#5C6378;"><mxGeometry x="0" y="64" width="1700" height="26" as="geometry"/></mxCell><mxCell id="k" parent="1" vertex="1" value="&lt;b&gt;IPPO trung bình 3 seed&lt;/b&gt;&lt;br&gt;Tổng chi phí 2.055.442 ± 14.358&lt;br&gt;Fill rate 90,9%" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E4D5F2;strokeColor=#9673A6;strokeWidth=2;fontSize=16;fontColor=#1F2937;align=center;verticalAlign=middle;strokeWidth=3;"><mxGeometry x="60" y="130" width="500" height="170" as="geometry"/></mxCell><mxCell id="r0" parent="1" vertex="1" value="&lt;b&gt;so với EOQ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:22px'&gt;&lt;b&gt;−17,8%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;IPPO rẻ hơn ở 3/3 seed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="60" y="340" width="370" height="130" as="geometry"/></mxCell><mxCell id="r1" parent="1" vertex="1" value="&lt;b&gt;so với (s,S)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:22px'&gt;&lt;b&gt;−1,7%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;IPPO rẻ hơn ở 3/3 seed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="450" y="340" width="370" height="130" as="geometry"/></mxCell><mxCell id="r2" parent="1" vertex="1" value="&lt;b&gt;so với EOQ theo nhóm&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:22px'&gt;&lt;b&gt;−0,9%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;rẻ hơn 2/3 seed, còn lại ngang" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="840" y="340" width="370" height="130" as="geometry"/></mxCell><mxCell id="r3" parent="1" vertex="1" value="&lt;b&gt;so với Newsvendor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:22px'&gt;&lt;b&gt;−0,3%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;không nhất quán giữa các seed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="60" y="490" width="370" height="130" as="geometry"/></mxCell><mxCell id="r4" parent="1" vertex="1" value="&lt;b&gt;so với (s,S) theo nhóm&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:22px'&gt;&lt;b&gt;+0,3%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;không nhất quán giữa các seed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="450" y="490" width="370" height="130" as="geometry"/></mxCell><mxCell id="r5" parent="1" vertex="1" value="&lt;b&gt;so với Newsvendor theo nhóm&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:22px'&gt;&lt;b&gt;+1,6%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;IPPO đắt hơn ở 3/3 seed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="840" y="490" width="370" height="130" as="geometry"/></mxCell><mxCell id="m" parent="1" vertex="1" value="&lt;b&gt;Đọc kết quả cho trung thực&lt;/b&gt;&lt;br&gt;&lt;br&gt;IPPO rẻ hơn rõ so với EOQ và (s,S); ngang các baseline tinh chỉnh theo nhóm.&lt;br&gt;Khi nhu cầu ổn định, baseline cổ điển ngang hoặc hơn; học tăng cường có lợi hơn khi nhu cầu biến động, ngày sự kiện, cuối tuần.&lt;br&gt;Nhóm hàng bán chậm: IPPO dưới 85% fill. Mùa lễ: IPPO đắt hơn baseline theo nhóm." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#16365C;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="600" y="130" width="1040" height="170" as="geometry"/></mxCell><mxCell id="n" parent="1" vertex="1" value="&lt;b&gt;Lưu ý:&lt;/b&gt; so ở cùng mức phục vụ ((s,S) −25,7%; Newsvendor −17,3%; EOQ không đạt) chỉ là cận trên vì fill của baseline vượt mục tiêu hơn 1 điểm % do lưới tham số thô. Ablation chỉ chạy 1 seed nên chênh lệch nhỏ chưa kết luận được." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#374151;"><mxGeometry x="60" y="660" width="1580" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="07 · Ứng dụng mô phỏng &amp; phiếu" id="p7"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" parent="1" vertex="1" value="ỨNG DỤNG MÔ PHỎNG: TỪ QUYẾT ĐỊNH CỦA MÔ HÌNH ĐẾN PHIẾU ĐỀ NGHỊ" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=center;fontColor=#16365C;"><mxGeometry x="0" y="20" width="1800" height="44" as="geometry"/></mxCell><mxCell id="st" parent="1" vertex="1" value="Chỉ suy luận: nạp checkpoint, chạy trên miền test như một tập test; không train" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;fontColor=#5C6378;"><mxGeometry x="0" y="64" width="1800" height="26" as="geometry"/></mxCell><mxCell id="d1" parent="1" vertex="1" value="&lt;b&gt;Chọn ngày, cửa hàng, ngành hàng, cách đặt hàng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="60" y="140" width="300" height="130" as="geometry"/></mxCell><mxCell id="d2" parent="1" vertex="1" value="&lt;b&gt;policy_runner&lt;/b&gt;&lt;br&gt;chạy mô phỏng tới ngày đã chọn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="440" y="140" width="300" height="130" as="geometry"/></mxCell><mxCell id="d3" parent="1" vertex="1" value="&lt;b&gt;Bảng đề xuất&lt;/b&gt;&lt;br&gt;chỉ những cặp cần đặt (số lượng &amp;gt; 0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="820" y="140" width="300" height="130" as="geometry"/></mxCell><mxCell id="d4" parent="1" vertex="1" value="&lt;b&gt;Gom phiếu&lt;/b&gt;&lt;br&gt;theo cửa hàng × ngành hàng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDE9D9;strokeColor=#E8A33D;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="1200" y="140" width="300" height="130" as="geometry"/></mxCell><mxCell id="d5" parent="1" vertex="1" value="&lt;b&gt;Phiếu ở trạng thái Nháp&lt;/b&gt;&lt;br&gt;người quản lý duyệt hoặc từ chối" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E4D5F2;strokeColor=#9673A6;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="1200" y="380" width="300" height="130" as="geometry"/></mxCell><mxCell id="d6" parent="1" vertex="1" value="&lt;b&gt;Phiếu đã duyệt&lt;/b&gt;&lt;br&gt;tải về dạng CSV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="820" y="380" width="300" height="130" as="geometry"/></mxCell><mxCell id="d7" parent="1" vertex="1" value="&lt;b&gt;Gửi phòng mua hàng&lt;/b&gt;&lt;br&gt;&lt;i&gt;ngoài phạm vi: báo giá, chọn nhà cung cấp&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F6FB;strokeColor=#8A93A8;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;dashed=1;"><mxGeometry x="440" y="380" width="300" height="130" as="geometry"/></mxCell><mxCell id="f1" parent="1" edge="1" source="d1" target="d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" parent="1" edge="1" source="d2" target="d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" parent="1" edge="1" source="d3" target="d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" parent="1" edge="1" source="d4" target="d5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" parent="1" edge="1" source="d5" target="d6" value="duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#374151;fontSize=12;fontStyle=1;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6" parent="1" edge="1" source="d6" target="d7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#8A93A8;fontSize=12;fontStyle=1;fontColor=#8A93A8;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rp" parent="1" vertex="1" value="&lt;b&gt;LỚP TỔNG HỢP BÁO CÁO (chỉ đọc)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cộng quyết định và kết quả của 300 tác tử thành KPI theo cửa hàng, theo ngành hàng và toàn mạng: đáp ứng nhu cầu, thiếu hàng, tồn kho trung bình, tổng lượng đặt, số lần đặt.&lt;br&gt;Không điều khiển tác tử nào, không đổi thuật toán: tổng hợp để báo cáo khác với điều phối để ra quyết định." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DDEBF7;strokeColor=#4472C4;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;"><mxGeometry x="60" y="590" width="1440" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>